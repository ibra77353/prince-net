# Base44 development defaults — placeholders so the app boots without credentials.
# Real secrets (JWT_SECRET, CSRF_SECRET) are delivered via /run/base44/app.env
# which overrides these because it is listed last in compose env_file.

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local infra — generated by compose)
DATABASE_URL=postgresql://prince_net:prince_net_pass@db:5432/prince_net?schema=public

# JWT
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=prince_net_token

# Cookies / Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=prince_net_csrf

# CORS (not triggered in single-origin proxy mode, but set for correctness)
CORS_ORIGIN=http://localhost:5173

# Admin (used only by seed)
ADMIN_EMAIL=admin@prince-net.local
ADMIN_PASSWORD=ChangeMeStrongPassword123

# App
APP_NAME=Prince Net
APP_CURRENCY=ريال
APP_CURRENCY_SYMBOL=ر.ي

# Backups
BACKUP_DIR=/tmp/prince-net-backups

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Web (Vite)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Prince Net
